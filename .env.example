# Fonte de dados do painel: "mock" (padrão, dados simulados) ou "postgres" (quando o banco existir).
DATA_SOURCE=mock

# Usado só quando DATA_SOURCE=postgres
DATABASE_URL=postgres://eco:eco@localhost:5432/ecossistema

# ---- Disparos & Fluxos (apps/admin) ----
# Sem esta variável: SIMULAÇÃO persistida no banco (nada sai para a Meta).
# meta = Meta Cloud API oficial (exige as três META_* abaixo).
# WHATSAPP_PROVIDER=meta
# META_SYSTEM_USER_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET=
# Protege POST /api/disparos/worker/tick (cron externo). Recomendado no modo meta.
# WORKER_SECRET=
# Simulação: fator dos atrasos simulados (entrega, leitura, resposta). 0.1 = 10× mais rápido.
# SIM_TIME_SCALE=0.1
