{
  "name": "@eco/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && prisma db push --skip-generate --accept-data-loss && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "tsx --test lib/disparos/tests/*.test.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@eco/core": "*",
    "@eco/tokens": "*",
    "@eco/ui": "*",
    "@prisma/client": "^6.1.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0"
  }
}
