// Camada de persistência v1 — Contingência (dados reais do operador).
// Neon Postgres (plano Free) conectado via Vercel. DATABASE_URL = pooled
// (pgbouncer) para a app; DATABASE_URL_UNPOOLED = conexão direta para migrações.
//
// Nota de arquitetura: este é o primeiro pedaço real de persistência do
// ecossistema (contingência). Os estados seguem o doc 04 (Segurança &
// Contingência). Multi-tenant/RLS/auth completos entram quando o portal do
// cliente for exposto; v1 é a ferramenta do operador para cadastrar sua
// própria contingência.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Cliente (tenant) que contrata a operação. 1 BM por cliente (regra do doc 04).
model Cliente {
  id        String     @id @default(cuid())
  nome      String
  slug      String     @unique
  plano     String     @default("starter") // starter | pro | scale | enterprise
  status    String     @default("ativo")   // ativo | trial | suspenso | inadimplente | cancelado
  notas     String?
  criadoEm  DateTime   @default(now())
  atualizadoEm DateTime @updatedAt
  bms       Bm[]
  numeros   Numero[]
  templates Template[]

  @@map("cliente")
}

/// Business Manager / portfólio da Meta.
model Bm {
  id           String   @id @default(cuid())
  nome         String
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  // doc 04 §4.2: em_verificacao | escalonando | ativa | restrita | banida
  status       String   @default("em_verificacao")
  // verificação de negócio na Meta
  verificacao  String   @default("pendente") // pendente | verificada | recusada
  // nível de limite 24h do portfólio (usuários únicos)
  nivelLimite  Int      @default(250) // 250 | 1000 | 10000 | 100000 (0 = ilimitado)
  metaBmId     String?  // ID do portfólio na Meta (quando conectar via app)
  notas        String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  numeros      Numero[]
  // ---- Conexão com a Meta (lib/meta/sync.ts). Nulos = BM só cadastrada à mão.
  metaNome           String?   // nome do portfólio na Meta
  metaSincronizadoEm DateTime? // última sincronização com a Graph API
  metaErro           String?   // último erro da Graph API (null = ok)
  wabas              Waba[]

  @@index([clienteId])
  @@map("bm")
}

/// Número de WhatsApp vinculado a uma BM.
model Numero {
  id           String   @id @default(cuid())
  telefone     String
  bmId         String?
  bm           Bm?      @relation(fields: [bmId], references: [id], onDelete: SetNull)
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  // doc 04 §4.2: pendente | aquecendo | ativo | limitado | restrito | banido | desconectado
  status       String   @default("pendente")
  // qualidade da Meta: alta | media | baixa | sem_avaliacao
  qualidade    String   @default("sem_avaliacao")
  enviadasHoje Int      @default(0)
  limiteDiario Int      @default(0)
  metaPhoneId  String?  // phone_number_id da Meta (quando conectar)
  notas        String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  // ---- Vindo da Meta (lib/meta/sync.ts). Nulos = número só cadastrado à mão.
  wabaId         String?
  waba           Waba?     @relation(fields: [wabaId], references: [id], onDelete: SetNull)
  nomeVerificado String?   // verified_name
  statusNome     String?   // name_status (APPROVED | PENDING_REVIEW | DECLINED…)
  statusMeta     String?   // status cru da Graph API (CONNECTED, FLAGGED…)
  vazao          String?   // throughput.level (STANDARD | HIGH…)
  podeEnviar     String?   // health_status.can_send_message: AVAILABLE | LIMITED | BLOCKED
  saude          Json?     // health_status.entities: erros e soluções que a Meta aponta
  sincronizadoEm DateTime?

  @@index([bmId])
  @@index([clienteId])
  @@index([metaPhoneId])
  @@index([wabaId])
  @@map("numero")
}

/// Template (HSM) aprovado na Meta.
model Template {
  id           String   @id @default(cuid())
  nome         String
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  categoria    String   @default("marketing") // marketing | utilidade | autenticacao
  status       String   @default("em_analise") // aprovado | em_analise | rejeitado | pausado | desativado
  idioma       String   @default("pt_BR")
  corpo        String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  // ---- Vindo da Meta (lib/meta/sync.ts).
  wabaId         String?
  waba           Waba?     @relation(fields: [wabaId], references: [id], onDelete: SetNull)
  metaTemplateId String?
  qualidade      String    @default("sem_avaliacao") // alta | media | baixa | sem_avaliacao
  motivoRejeicao String?
  componentes    Json?     // components crus da Meta (header, body, footer, buttons)
  sincronizadoEm DateTime?

  @@index([clienteId])
  @@index([metaTemplateId])
  @@index([wabaId])
  @@map("template")
}

// =============================================================================
// Disparos & Fluxos (chat 5) — tabelas novas, nada acima foi alterado.
//
// Nomes e enums em inglês, iguais ao @eco/core (Lead, ConsentEvent,
// CampaignStatus...), para não migrar duas vezes. `clienteId` = tenant; em v1
// fica null (escopo único do operador, sem auth/RLS ainda — doc 04).
// `numeroId`/`templateId` apontam para as tabelas de contingência sem FK por
// enquanto (excluir número/template não pode quebrar o CRUD existente); a FK
// composta (tenant_id, id) entra junto com o RLS.
//
// Opt-out por design: Lead.consent é a projeção do último ConsentEvent
// (append-only). Campanha só envia para consent = opted_in; opted_out vence
// tudo e importar contatos nunca reativa ninguém.
// =============================================================================

/// Contato do tenant. Único por telefone (E.164) dentro do tenant.
/// Conta WhatsApp Business (WABA) dentro de uma BM conectada à Meta.
model Waba {
  id              String     @id @default(cuid())
  metaWabaId      String     @unique
  bmId            String
  bm              Bm         @relation(fields: [bmId], references: [id], onDelete: Cascade)
  nome            String
  statusRevisao   String?    // account_review_status: APPROVED | PENDING | REJECTED
  podeEnviar      String?    // health_status.can_send_message: AVAILABLE | LIMITED | BLOCKED
  saude           Json?      // health_status.entities
  webhookAssinado Boolean    @default(false) // POST /{waba}/subscribed_apps feito
  sincronizadoEm  DateTime?
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt
  numeros         Numero[]
  templates       Template[]

  @@index([bmId])
  @@map("waba")
}

/// Webhooks de contingência recebidos da Meta (qualidade, template, conta). Log para auditoria/diagnóstico.
model MetaEvento {
  id         String   @id @default(cuid())
  campo      String   // phone_number_quality_update, message_template_status_update…
  metaWabaId String?
  resumo     String   // frase legível do que mudou
  payload    Json
  erro       String?
  recebidoEm DateTime @default(now())

  @@index([recebidoEm])
  @@map("meta_evento")
}

model Lead {
  id               String    @id @default(cuid())
  clienteId        String?
  phone            String
  name             String    @default("")
  tags             String[]  @default([])
  attributes       Json      @default("{}")
  /// opted_in | opted_out | unknown — projeção do último ConsentEvent
  consent          String    @default("unknown")
  /// web_form | checkout | whatsapp_inbound | whatsapp_keyword | opt_out_button | import | api | support_request | admin
  consentSource    String?
  consentChangedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([clienteId, phone])
  @@index([clienteId, consent])
  @@map("lead")
}

/// Log imutável de consentimento. Nunca atualizar nem apagar.
model ConsentEvent {
  id          String   @id @default(cuid())
  clienteId   String?
  leadId      String?
  phone       String
  /// opted_in | opted_out
  status      String
  source      String
  /// motivo / descrição da origem do opt-in
  note        String?
  /// texto que o contato mandou (ex.: "SAIR")
  keyword     String?
  waMessageId String?
  campaignId  String?
  flowRunId   String?
  createdAt   DateTime @default(now())

  @@index([clienteId, phone, createdAt])
  @@index([clienteId, status, createdAt])
  @@map("consent_event")
}

/// Fluxo de automação. O rascunho é editável; publicar cria uma FlowVersion imutável.
model Flow {
  id                 String        @id @default(cuid())
  clienteId          String?
  name               String
  description        String?
  /// draft | published | archived
  status             String        @default("draft")
  /// grafo { nodes, edges } — ver lib/disparos/domain/flow-types.ts
  draftGraph         Json
  publishedVersionId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  versions           FlowVersion[]

  @@index([clienteId, updatedAt])
  @@map("flow")
}

model FlowVersion {
  id          String   @id @default(cuid())
  clienteId   String?
  flowId      String
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version     Int
  graph       Json
  publishedAt DateTime @default(now())

  @@unique([flowId, version])
  @@map("flow_version")
}

/// Disparo: um público, um número, uma versão de fluxo.
model Campaign {
  id              String              @id @default(cuid())
  clienteId       String?
  name            String
  numeroId        String
  flowId          String
  flowVersionId   String
  /// draft | scheduled | running | paused | completed | canceled | failed
  status          String              @default("draft")
  pauseReason     String?
  /// freio temporário sem mudar o status (ex.: messaging_limit)
  blockedReason   String?
  /// { tags: string[], all?: boolean }
  audience        Json
  ratePerMinute   Int                 @default(60)
  totalRecipients Int                 @default(0)
  /// simulation | meta
  provider        String              @default("simulation")
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastDispatchAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  recipients      CampaignRecipient[]

  @@index([status])
  @@index([clienteId, createdAt])
  @@map("campaign")
}

/// Público congelado na criação. Status do 1º envio + vínculo com a execução do fluxo.
model CampaignRecipient {
  id          String    @id @default(cuid())
  clienteId   String?
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String?
  phone       String
  name        String    @default("")
  variables   Json      @default("{}")
  /// pending | processing | accepted | sent | delivered | read | failed | skipped_optout | skipped_no_consent | skipped_invalid
  status      String    @default("pending")
  attempts    Int       @default(0)
  flowRunId   String?
  waMessageId String?
  errorCode   Int?
  errorTitle  String?
  acceptedAt  DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  updatedAt   DateTime  @default(now())

  @@index([campaignId, status])
  @@index([waMessageId])
  @@map("campaign_recipient")
}

/// Execução do fluxo para um contato.
model FlowRun {
  id                  String    @id @default(cuid())
  clienteId           String?
  flowId              String
  flowVersionId       String
  campaignId          String?
  campaignRecipientId String?
  numeroId            String
  leadId              String?
  phone               String
  /// active | waiting_delay | waiting_reply | completed | opted_out | failed | canceled
  status              String
  currentNodeId       String?
  wakeAt              DateTime?
  /// { vars, answers }
  context             Json      @default("{}")
  stepCount           Int       @default(0)
  lastError           String?
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  updatedAt           DateTime  @default(now())

  @@index([status, wakeAt])
  @@index([clienteId, phone, status])
  @@index([campaignId, status])
  @@map("flow_run")
}

/// Trilha por etapa (funil da campanha).
model FlowRunStep {
  id         Int      @id @default(autoincrement())
  clienteId  String?
  runId      String
  campaignId String?
  nodeId     String
  nodeType   String
  outcome    String
  messageId  String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([campaignId, nodeId, outcome])
  @@index([runId])
  @@map("flow_run_step")
}

/// Mensagem enviada ou recebida (espelha a Cloud API).
model Message {
  id                    String    @id @default(cuid())
  clienteId             String?
  numeroId              String
  leadId                String?
  phone                 String
  /// in | out
  direction             String
  waMessageId           String?   @unique
  type                  String
  payload               Json
  preview               String    @default("")
  /// queued | accepted | sent | delivered | read | played | failed | received
  status                String
  statusRank            Int       @default(0)
  campaignId            String?
  flowRunId             String?
  nodeId                String?
  bizOpaqueCallbackData String?
  errorCode             Int?
  errorTitle            String?
  pricingCategory       String?
  pricingType           String?
  createdAt             DateTime  @default(now())
  sentAt                DateTime?
  deliveredAt           DateTime?
  readAt                DateTime?
  failedAt              DateTime?

  @@index([clienteId, phone, createdAt])
  @@index([numeroId, direction, type, createdAt])
  @@map("message")
}

/// Idempotência dos webhooks de status (a Meta reenvia).
model MessageStatusEvent {
  waMessageId String
  status      String
  createdAt   DateTime @default(now())

  @@id([waMessageId, status])
  @@map("message_status_event")
}

/// Última mensagem recebida do contato por número: janela de atendimento de 24 h.
model ServiceWindow {
  numeroId      String
  phone         String
  lastInboundAt DateTime

  @@id([numeroId, phone])
  @@map("service_window")
}

/// Webhooks a processar. source = meta (recebido) | simulation (agendado pelo simulador).
model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  dueAt       DateTime  @default(now())
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt, dueAt])
  @@map("webhook_event")
}

/// Trava do worker (lease): garante um tick por vez entre instâncias serverless.
model WorkerLease {
  name  String   @id
  until DateTime

  @@map("worker_lease")
}
